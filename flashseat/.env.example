# ── Local development (npm run dev) — services from `docker compose up -d postgres redis` ──
NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Pool sizing: (API replicas + worker replicas) x connection_limit  <  postgres max_connections (200)
DATABASE_URL=postgresql://flashseat:flashseat@localhost:5432/flashseat?connection_limit=20&pool_timeout=10
REDIS_URL=redis://localhost:6379

# >= 32 chars. Generate:  openssl rand -hex 32
JWT_SECRET=dev-only-change-me-dev-only-change-me
JWT_EXPIRES_IN=1h
# HMAC secret shared with the (mock) payment gateway. Generate:  openssl rand -hex 24
PAYMENT_WEBHOOK_SECRET=whsec_dev_only_change_me

# ── Booking domain ──
HOLD_TTL_SECONDS=480
MAX_SEATS_PER_HOLD=6

# ── Idempotency ──
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_SECONDS=30

# ── Sliding-window rate limiter ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_PER_USER=20
RATE_LIMIT_MAX_PER_IP=300

# ── Worker / lifecycle ──
WORKER_CONCURRENCY=10
SHUTDOWN_TIMEOUT_MS=10000
